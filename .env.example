# todonow — modelo de variáveis de ambiente
# Copie para .env e ajuste:  cp .env.example .env

# ---------- obrigatório em produção ----------
# Gere com:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Deixe vazio para o app criar e persistir uma chave em /data/secret_key.
SECRET_KEY=

# ---------- primeiro acesso ----------
# Se preenchido, o container cria este admin no start (sem sobrescrever
# uma conta existente). Depois do primeiro boot você pode remover as linhas.
TODONOW_ADMIN_USER=
TODONOW_ADMIN_PASSWORD=
TODONOW_ADMIN_EMAIL=

# Controla a aba "Criar conta" da tela de login:
#   yes  = sempre aberta (cada pessoa cria a própria conta)
#   auto = aberta apenas enquanto não existir nenhum usuário
#          (depois disso a aba aparece desabilitada)
#   no   = fechada (só o admin cria contas em Usuários)
ALLOW_REGISTRATION=yes
FIRST_USER_IS_ADMIN=true

# ---------- imagem ----------
# Publicada no Docker Hub: https://hub.docker.com/r/nickolback/todonow
# A imagem publicada é amd64. Em ARM, construa com:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml build
TODONOW_IMAGE=nickolback/todonow:latest
# always = confere/baixa a cada `docker compose up` (padrão: acompanha a latest)
# missing = usa a local se existir, só baixa quando faltar
TODONOW_PULL_POLICY=always

# ---------- rede / servidor ----------
# Porta no host. 8081 evita a colisão mais comum (8000 é usada por Portainer,
# outros apps Flask, …). Para ver o que está ocupado: ss -ltn | grep :PORTA
TODONOW_PORT=8081
# Porta interna do container (raramente precisa mudar).
TODONOW_CONTAINER_PORT=8000
# Interface onde a porta é publicada. Padrão 0.0.0.0 (todas).
#   TODONOW_BIND=127.0.0.1     -> só na própria máquina (use com Tailscale Serve)
#   TODONOW_BIND=100.x.y.z     -> só no IP do Tailscale
TODONOW_BIND=0.0.0.0
# true somente se você publicar o app via HTTPS (proxy reverso)
SESSION_COOKIE_SECURE=false

# ---------- acesso remoto / proxy (Tailscale, Caddy, Nginx) ----------
# true quando o TLS termina num proxy à frente (Tailscale Serve, por exemplo).
# Faz o app respeitar X-Forwarded-Proto/Host.
TRUST_PROXY=false
# Quantos proxies confiar (normalmente 1).
TRUST_PROXY_HOPS=1
# Hosts aceitos, separados por vírgula (vazio = aceita qualquer Host).
# Ex.: TRUSTED_HOSTS=todonow.minha-tailnet.ts.net,100.64.0.1
TRUSTED_HOSTS=

# ---------- localização ----------
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
# 0 = segunda-feira … 6 = domingo
WEEK_START=6
DEFAULT_THEME=light

# ---------- desempenho (homelab / < 4 GB) ----------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
TASKS_PER_PAGE=50

# ---------- limites do container ----------
TODONOW_MEM_LIMIT=512m
TODONOW_CPUS=1.0

# ---------- backups ----------
BACKUP_DIR=/data/backups
BACKUP_KEEP=20
ALLOW_FULL_RESTORE=true

# ---------- marca ----------
APP_NAME=todonow
